# Postgres. Railway provides this automatically when a Postgres service is attached.
DATABASE_URL=postgres://user:password@localhost:5432/nextfloor

# Local development uses these automatically. Anthropic alone enables hints.
# Production never exposes these without PUBLIC_GENERATION=true.
# Browser keys work independently of the public flag and allowance.
ANTHROPIC_API_KEY=
FAL_KEY=

# Anonymous production use: explicit opt-in, with the server keys above.
# Monthly AI budget accrues in daily portions (Los Angeles calendar), with
# unused portions carrying within the month. 5% is allocated to room hints.
# Four public floor attempts/day remains an additional ceiling.
PUBLIC_GENERATION=false
PUBLIC_MONTHLY_BUDGET_USD=10

# Optional public allowance: four attempts/day, $10/month total AI usage.
# Legacy alternative using dedicated keys and the original fixed $10 allowance.
# Prefer PUBLIC_GENERATION and ordinary server keys for new installations.
# $9.50 is reserved for floors; $0.50 for shared suggestions. Defaults OFF.
# Prices are checked automatically; unavailable or increased prices fail closed.
SPONSORED_GENERATION=false
SPONSORED_ANTHROPIC_KEY=
SPONSORED_FAL_KEY=

# Tests must point to a separate localhost database whose name ends in _test.
# TEST_DATABASE_URL=postgres://postgres:nextfloor-test@127.0.0.1:55439/nextfloor_test

# Optional. Without a bucket, tiles are stored in Postgres.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set to true only if your Postgres requires TLS. Railway's private network does not.
# DATABASE_SSL=false

# The theme interpreter. Defaults to claude-sonnet-5; claude-opus-5 writes
# richer floors and costs about 2.5x more per floor.
# ANTHROPIC_SPEC_MODEL=claude-sonnet-5

# Image models. Defaults are Nano Banana; set the edit model to
# fal-ai/flux-2-pro/edit to compare.
# FAL_SEED_MODEL=fal-ai/nano-banana-2
# FAL_EDIT_MODEL=fal-ai/nano-banana-pro/edit

# Local transparency experiment: Nano Banana artwork + BiRefNet alpha mask.
# Enable in .env.local; pnpm dev and pnpm dev:alpha use the same settings.
# Disabled in production and for sponsored requests during evaluation.
# FAL_TRANSPARENCY=birefnet
# Raw render, mask and result are retained in .local/transparency/<floor-id>/.

# Lets the image model fetch the reference tile by URL instead of base64.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# The floor edit prompt. Defaults to the short one in
# src/lib/prompts/edit-instructions-basic.md; set to `full` to fall back to the
# longer edit-instructions.md that the earlier floors were drawn against.
# EDIT_PROMPT=full
