# Postgres. Railway provides this automatically when a Postgres service is attached.
DATABASE_URL=postgres://user:password@localhost:5432/nextfloor

# Bring your own key is the default: visitors supply their own keys in the browser.
# Set this to true to let the server fall back to the keys below. Leave it unset on
# a public deployment unless you want strangers spending your credit.
ALLOW_SERVER_KEYS=false
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional. Without a bucket, tiles are stored in Postgres.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set to true only if your Postgres requires TLS. Railway's private network does not.
# DATABASE_SSL=false
